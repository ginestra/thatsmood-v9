{
  "name": "thatsmood-v9",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy && npm run minify",
    "minify": "npm run minify:css && npm run minify:js",
    "minify:css": "esbuild site/assets/css/main.css --minify --outfile=_site/assets/css/main.css",
    "minify:js": "esbuild site/assets/js/main.js --minify --target=es2020 --outfile=_site/assets/js/main.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "esbuild": "^0.28.2"
  }
}
