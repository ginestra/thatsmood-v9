---
layout: layouts/base.njk
title: Home
permalink: /
---
{% from "partials/icons.njk" import icon %}

<section class="section container">
  <div class="hero">
    <div class="hero__content">
      <h1 class="hero__title animate-fade-in">
        Hi, I'm Ginestra
      </h1>
      <h2 class="hero__subtitle animate-fade-in animate-fade-in--delay-1">
        UX &amp; Product Design Lead
      </h2>
      <p class="hero__text animate-fade-in animate-fade-in--delay-2">
        I make complex digital products easier to understand and use, with accessibility and inclusive design at the heart of my work.
      </p>
      <h3>Strategy, leadership & the bigger picture</h3>      
      <p class="hero__text animate-fade-in animate-fade-in--delay-2">
        I work with leadership, product and engineering teams to challenge assumptions, connect user needs with business goals, and shape product direction.
      </p>
      <p class="hero__text animate-fade-in animate-fade-in--delay-2">
        Because building things quickly is one thing.<br><strong>Building things worth using is another.</strong>
      </p>
      
      <div class="btn-group animate-fade-in animate-fade-in--delay-3">
        <a href="{{ '/work/' | url }}" class="button-link no-bg">
          <span class="btn btn--primary">
            View my work
            {{ icon("arrow-right") }}
          </span>
        </a>
        <a href="{{ '/cv/' | url }}" class="button-link no-bg">
          <span class="btn btn--outline">Download CV</span>
        </a>
      </div>
    </div>
    <div class="hero__visual">
      <div class="hero__avatar animate-fade-in">
        <img src="{{ '/assets/my-shadow.svg' | url }}" alt="Profile">
      </div>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <h2 class="feature-grid__heading">What I Do</h2>
    <h3>Direction &amp; Leadership</h3>
    <div class="feature-grid">
      <article class="feature-card">
        <div class="feature-card__icon">{{ icon("compass") }}</div>
        <h3 class="feature-card__title">Mission</h3>
        <p class="feature-card__text">Finding common ground between what users need and what the business wants to achieve</p>
      </article>
      <article class="feature-card">
        <div class="feature-card__icon">{{ icon("telescope") }}</div>
        <h3 class="feature-card__title">Vision</h3>
        <p class="feature-card__text">Looking beyond what's in front of us to help shape where the product should go</p>
      </article>
      <article class="feature-card">
        <div class="feature-card__icon">{{ icon("route") }}</div>
        <h3 class="feature-card__title">Strategy</h3>
        <p class="feature-card__text">Turning ideas and ambitions into priorities, decisions and a realistic way forward</p>
      </article>
    </div>
    <h3>Design Practice</h3>
    <div class="feature-grid">
      <article class="feature-card">
        <div class="feature-card__icon">{{ icon("eye") }}</div>
        <h3 class="feature-card__title">UX Research</h3>
        <p class="feature-card__text">Asking questions, challenging assumptions and finding out what people actually need</p>
      </article>
      <article class="feature-card">
        <div class="feature-card__icon">{{ icon("code") }}</div>
        <h3 class="feature-card__title">UI Design</h3>
        <p class="feature-card__text">Creating interfaces that are easy to use and provide a good user experience</p>
      </article>
      <article class="feature-card">
        <div class="feature-card__icon">{{ icon("smartphone") }}</div>
        <h3 class="feature-card__title">Accessibility</h3>
        <p class="feature-card__text">Making accessibility part of the process, not something to fix at the end</p>
      </article>
    </div>
  </div>
</section>
