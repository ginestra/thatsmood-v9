---
layout: layouts/base.njk
title: Work
permalink: /work/
---
{% from "partials/icons.njk" import icon %}
{% from "partials/category-badges.njk" import categoryBadges %}
{% set availableCategories = collections.projects | collectionCategories %}

<section class="section container" data-category-filter data-filter-singular="case study" data-filter-plural="case studies">
  <header class="page-header page-header--work">
    <span class="page-header__eyebrow">Selected work</span>
    <h1 class="page-header__title">Product strategy, design leadership and hands-on delivery</h1>
    <p class="page-header__lead">
      I help teams turn complex customer and business challenges into clear product direction, then work with them to bring that direction to life through research, design and delivery.
    </p>
  </header>

  {% if availableCategories.length %}
    <div class="category-filter" aria-labelledby="work-filter-label">
      <span class="category-filter__label" id="work-filter-label">Filter by category</span>
      <div class="category-filter__options" role="group" aria-labelledby="work-filter-label">
        <button type="button" class="category-filter__button" data-category-option="all" aria-pressed="true">All</button>
        {% for category in availableCategories %}
          <button type="button" class="category-filter__button" data-category-option="{{ category.slug }}" aria-pressed="false">{{ category.name }}</button>
        {% endfor %}
      </div>
      <span class="sr-only" aria-live="polite" data-filter-status></span>
    </div>
  {% endif %}

  <div class="work-featured" data-filter-group>
    {% for project in collections.projects %}
      {% if loop.first %}
        {% set projectCategories = project.data.category | categoryList %}
        <article class="project-card project-card--featured" data-category-item data-categories="{% for category in projectCategories %}{{ category | categorySlug }}{% if not loop.last %} {% endif %}{% endfor %}">
          <div class="project-card__image-wrap">
            <img src="{{ project.data.image }}" alt="{{ project.data.imageAlt or '' }}">
          </div>
          <div class="project-card__body">
            <span class="project-card__eyebrow">Featured case study</span>
            {{ categoryBadges(project.data.category, "filter") }}
            <h2 class="project-card__title">{{ project.data.title }}</h2>
            {% if project.data.subtitle %}
              <p class="content-subtitle content-subtitle--card">{{ project.data.subtitle }}</p>
            {% endif %}
            <p class="project-card__desc">{{ project.data.description }}</p>
            {% if project.data.role or project.data.impact %}
              <dl class="project-card__meta">
                {% if project.data.role %}
                  <div>
                    <dt>My role</dt>
                    <dd>{{ project.data.role }}</dd>
                  </div>
                {% endif %}
                {% if project.data.impact %}
                  <div>
                    <dt>Impact</dt>
                    <dd>{{ project.data.impact }}</dd>
                  </div>
                {% endif %}
              </dl>
            {% endif %}
            {% if project.data.capabilities %}
              <ul class="project-card__capabilities" aria-label="Capabilities demonstrated">
                {% for capability in project.data.capabilities %}
                  <li>{{ capability }}</li>
                {% endfor %}
              </ul>
            {% endif %}
            <a href="{{ project.url | url }}" class="link-card no-bg">
              <span class="btn btn--ghost">
                View case study
                {{ icon("arrow-right") }}
              </span>
            </a>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {% if collections.projects.length > 1 %}
    <div class="card-grid" data-filter-group>
      {% for project in collections.projects %}
        {% if not loop.first %}
          {% set projectCategories = project.data.category | categoryList %}
          <article class="project-card" data-category-item data-categories="{% for category in projectCategories %}{{ category | categorySlug }}{% if not loop.last %} {% endif %}{% endfor %}">
            <div class="project-card__image-wrap">
              <img src="{{ project.data.image }}" alt="{{ project.data.imageAlt or '' }}">
            </div>
            <div class="project-card__body">
              {{ categoryBadges(project.data.category, "filter") }}
              <h2 class="project-card__title">{{ project.data.title }}</h2>
              {% if project.data.subtitle %}
                <p class="content-subtitle content-subtitle--card">{{ project.data.subtitle }}</p>
              {% endif %}
              <p class="project-card__desc">{{ project.data.description }}</p>
              {% if project.data.role or project.data.impact %}
                <dl class="project-card__meta">
                  {% if project.data.role %}
                    <div>
                      <dt>My role</dt>
                      <dd>{{ project.data.role }}</dd>
                    </div>
                  {% endif %}
                  {% if project.data.impact %}
                    <div>
                      <dt>Impact</dt>
                      <dd>{{ project.data.impact }}</dd>
                    </div>
                  {% endif %}
                </dl>
              {% endif %}
              {% if project.data.capabilities %}
                <ul class="project-card__capabilities" aria-label="Capabilities demonstrated">
                  {% for capability in project.data.capabilities %}
                    <li>{{ capability }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
              <a href="{{ project.url | url }}" class="link-card no-bg">
                <span class="btn btn--ghost">
                  View case study
                  {{ icon("arrow-right") }}
                </span>
              </a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <aside class="work-context" aria-labelledby="work-context-title">
    <h2 id="work-context-title">A note on confidential work</h2>
    <p>Some case studies may omit or generalise commercially sensitive details. They focus on the decisions I made, how I worked with others and the impact of the work.</p>
  </aside>
</section>
