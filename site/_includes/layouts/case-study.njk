---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}

<article class="section container container--narrow">
  <a href="{{ '/work/' | url }}" class="article-back no-bg">
    <span class="btn btn--ghost">
      {{ icon("arrow-left") }}
      Back to Work
    </span>
  </a>

  <span class="project-card__category">{{ category }}</span>
  <h1 class="article-title">{{ title }}</h1>

  <div class="article-hero">
    <img src="{{ image }}" alt="{{ title }}">
  </div>

  <div class="prose">
    <h2>Overview</h2>
    <p class="article-lead">{{ description }}</p>

    {% if challenge or approach or outcome or content %}
      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Case study sections">
          <button type="button" class="tabs__trigger" role="tab" aria-selected="true" data-tab-trigger="challenge">The Challenge</button>
          <button type="button" class="tabs__trigger" role="tab" aria-selected="false" data-tab-trigger="approach">The Approach</button>
          <button type="button" class="tabs__trigger" role="tab" aria-selected="false" data-tab-trigger="outcome">The Outcome</button>
          {% if content %}
            <button type="button" class="tabs__trigger" role="tab" aria-selected="false" data-tab-trigger="details">Project Details</button>
          {% endif %}
        </div>

        <div class="tabs__panel is-active" data-tab-panel="challenge" role="tabpanel">
          <p>{{ challenge or "Coming soon..." }}</p>
        </div>
        <div class="tabs__panel" data-tab-panel="approach" role="tabpanel">
          <p>{{ approach or "Coming soon..." }}</p>
        </div>
        <div class="tabs__panel" data-tab-panel="outcome" role="tabpanel">
          <p>{{ outcome or "Coming soon..." }}</p>
        </div>
        {% if content %}
          <div class="tabs__panel" data-tab-panel="details" role="tabpanel">
            {{ content | safe }}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="placeholder-box">
        <p>Full case study coming soon...</p>
      </div>
    {% endif %}
  </div>
</article>
