---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}
{% from "partials/category-badges.njk" import categoryBadges %}

<article class="section container container--narrow">
  <a href="{{ '/work/' | url }}" class="article-back no-bg">
    <span class="btn btn--ghost">
      {{ icon("arrow-left") }}
      Back to Work
    </span>
  </a>

  {{ categoryBadges(category, "link", "/work/") }}
  <h1 class="article-title">{{ title }}</h1>
  {% if subtitle %}
    <p class="content-subtitle content-subtitle--article">{{ subtitle }}</p>
  {% endif %}

  {% if role or timeframe or team %}
    <dl class="case-study__meta">
      {% if role %}
        <div>
          <dt>My role</dt>
          <dd>{{ role }}</dd>
        </div>
      {% endif %}
      {% if timeframe %}
        <div>
          <dt>Timeframe</dt>
          <dd>{{ timeframe }}</dd>
        </div>
      {% endif %}
      {% if team %}
        <div>
          <dt>Team</dt>
          <dd>{{ team }}</dd>
        </div>
      {% endif %}
    </dl>
  {% endif %}

  {% if capabilities %}
    <ul class="case-study__capabilities" aria-label="Capabilities demonstrated">
      {% for capability in capabilities %}
        <li>{{ capability }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  <div class="article-hero">
    <img src="{{ image | url }}" alt="{{ imageAlt or '' }}">
  </div>

  <div class="prose case-study">
    <section class="case-study__intro" aria-labelledby="case-study-overview">
      <h2 id="case-study-overview">Overview</h2>
      <p class="article-lead">{{ description }}</p>
    </section>

    {% if challenge or approach or outcome or content %}
      {% if challenge %}
        <section class="case-study__section" aria-labelledby="case-study-challenge">
          <h2 id="case-study-challenge">The challenge</h2>
          <p>{{ challenge }}</p>
        </section>
      {% endif %}

      {% if approach %}
        <section class="case-study__section" aria-labelledby="case-study-approach">
          <h2 id="case-study-approach">The approach</h2>
          <p>{{ approach }}</p>
        </section>
      {% endif %}

      {% if content %}
        <div class="case-study__section case-study__details">
          {{ content | safe }}
        </div>
      {% endif %}

      {% if outcome %}
        <section class="case-study__section case-study__outcome" aria-labelledby="case-study-outcome">
          <h2 id="case-study-outcome">The outcome</h2>
          <p>{{ outcome }}</p>
        </section>
      {% endif %}
    {% else %}
      <div class="placeholder-box">
        <p>Full case study coming soon...</p>
      </div>
    {% endif %}
  </div>
</article>
