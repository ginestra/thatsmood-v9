---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}
{% from "partials/category-badges.njk" import categoryBadges %}

<article class="section container container--narrow">
  <a href="{{ '/thoughts/' | url }}" class="article-back no-bg">
    <span class="btn btn--ghost">
      {{ icon("arrow-left") }}
      Back to Thoughts
    </span>
  </a>

  <div class="article-meta">
    {{ categoryBadges(category, "link", "/thoughts/") }}
    <span class="thought-card__date">
      {{ icon("calendar") }}
      {{ date | readableDate }}
    </span>
  </div>

  <h1 class="article-title">{{ title }}</h1>
  {% if subtitle %}
    <p class="content-subtitle content-subtitle--article">{{ subtitle }}</p>
  {% endif %}

  <div class="article-hero">
    <img src="{{ image }}" alt="{{ title }}">
  </div>

  <div class="prose">
    <p class="article-lead">{{ excerpt }}</p>
    {% if content %}
      {{ content | safe }}
    {% else %}
      <div class="placeholder-box">
        <p>Full article coming soon...</p>
      </div>
    {% endif %}
  </div>
</article>
